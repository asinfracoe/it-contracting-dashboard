# Azure Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure Cosmos DB
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_KEY=your-key
COSMOS_DB_DATABASE=it-bom-db

# Azure Data Lake Storage
ADLS_ACCOUNT_NAME=your-storage-account
ADLS_ACCOUNT_KEY=your-storage-key
ADLS_CONTAINER_RAW_BOMS=raw-boms
ADLS_CONTAINER_PROCESSED=processed-boms
ADLS_CONTAINER_TEMPLATES=templates
ADLS_CONTAINER_EXPORTS=exports

# Azure Key Vault
KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Anthropic Claude API (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Direct OpenAI API (easiest option — get key from platform.openai.com)
# Set this if you have an OpenAI account. Supports gpt-4o, gpt-4-turbo, etc.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_DEFAULT=gpt-4o

# Azure OpenAI (alternative to Anthropic - if you have Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# SharePoint
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/IT-BOMs
SHAREPOINT_CLIENT_ID=your-sp-client-id
SHAREPOINT_CLIENT_SECRET=your-sp-client-secret

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-key
FROM_EMAIL=bom-system@yourcompany.com

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Feature Flags - Set to True to use dummy data (for local development)
USE_DUMMY_COSMOS=True
USE_DUMMY_ADLS=True
USE_DUMMY_SHAREPOINT=True
USE_DUMMY_CLAUDE=False
USE_AZURE_OPENAI=False

# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Claude API Settings
CLAUDE_MODEL_DEFAULT=claude-3-5-sonnet-20241022
CLAUDE_MODEL_FAST=claude-3-haiku-20240307
CLAUDE_MODEL_COMPLEX=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3
