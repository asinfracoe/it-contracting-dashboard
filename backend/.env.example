ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
JWT_SECRET_KEY=your-jwt-secret-key-here

USE_DUMMY_CLAUDE=false
USE_AZURE_OPENAI=false

AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic
AZURE_OPENAI_CHAT_DEPLOYMENT=claude-opus-4-6
AZURE_OPENAI_API_VERSION=2024-02-01

USE_DUMMY_COSMOS=false
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-db-key
COSMOS_DB_DATABASE=it-bom-db

USE_DUMMY_ADLS=false
ADLS_ACCOUNT_NAME=your-storage-account-name
ADLS_ACCOUNT_KEY=your-adls-account-key
ADLS_CONTAINER_RAW_BOMS=raw-boms
ADLS_CONTAINER_PROCESSED=processed-boms
ADLS_CONTAINER_TEMPLATES=templates
ADLS_CONTAINER_EXPORTS=exports
ADLS_CONTAINER_CHAT_HISTORY=chat-history
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net

USE_DUMMY_SHAREPOINT=false
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/YourSite
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_DRIVE_PATH=YourDocumentLibraryFolder

KEYVAULT_URL=https://your-keyvault.vault.azure.net/

AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
